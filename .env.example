# Copy to .env.local for local development. On Vercel, set these in Project -> Settings ->
# Environment Variables. Never put real values in this file: it is committed.

# --- Site ----------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://kamusi.denex.co.ke
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_ADSENSE_ID=ca-pub-2511222876461022

# --- Database: Neon via Vercel Storage -----------------------------------------------------
# Vercel -> Storage -> Create Database -> Neon. Connecting it to the project injects
# DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct, used for migrations) automatically.
# Locally, use a Neon branch or a Docker Postgres:
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=kamusi postgres:17-alpine
DATABASE_URL=postgres://postgres:dev@localhost:5432/kamusi
DATABASE_URL_UNPOOLED=

# Tests wipe this database. Use a throwaway local/CI Postgres only (hosted URLs are refused).
TEST_DATABASE_URL=postgres://postgres:test@localhost:55432/kamusi

# --- Auth (Clerk) --------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- AI providers --------------------------------------------------------------------------
# Tried in this order; a provider with no keys is skipped. On a rate limit the next key of the
# same provider is tried, then the next provider. Each provider takes up to 4 keys:
# NAME_API_KEY_1 ... NAME_API_KEY_4 (NAME_API_KEY works too).
# Keys from the SAME account share that account's limits: they add failover, not capacity.
AI_PROVIDERS=groq,gemini,openrouter

GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-flash-latest

OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_MODEL=openrouter/free

# Optional: related videos for courses created with "Include video lessons".
YOUTUBE_API_KEY=

# --- Payments (Paystack) -------------------------------------------------------------------
# Webhook URL to set in the Paystack dashboard: https://kamusi.denex.co.ke/api/paystack-webhook
PAYSTACK_SECRET_KEY=
